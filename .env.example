# Copy to .env.local for local dev, then fill in ONE of these.
# .env.local is git-ignored. Full walkthrough: CONTACT-SETUP.md

# Recommended — Web3Forms, free tier is 250 submissions/month, no account needed.
# Get a key by entering the studio inbox at https://web3forms.com
VITE_WEB3FORMS_KEY=

# Alternative — Formspree, free tier is 50 submissions/month.
# Dashboard → your form → Integration → the ID in https://formspree.io/f/XXXXXXXX
VITE_FORMSPREE_ID=

# Alternative — your own API endpoint accepting a JSON POST.
VITE_CONTACT_ENDPOINT=

# Leave all three empty and the contact form falls back to opening the
# visitor's mail client with the brief pre-filled (never a dead end).
